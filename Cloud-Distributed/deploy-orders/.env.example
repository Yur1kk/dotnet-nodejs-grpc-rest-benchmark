# Copy this file to .env and fill in values for your environment.
# On GCP: leave this file absent — docker-compose.yml defaults to GCP internal IPs automatically.
# Locally: create .env with the values below.

# Host where PostgreSQL is running.
# Local (Windows Docker Desktop): host.docker.internal
# GCP (default):                  10.186.0.2
DB_HOST=host.docker.internal

# Host where users-service is running.
# Local (Windows Docker Desktop): host.docker.internal
# GCP (default):                  10.186.0.6
USERS_HOST=host.docker.internal
